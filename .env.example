# Copy to .env. Every variable here is read by medic/config.py; nothing else.

# LLM provider: "gemini" (default) or "anthropic". Model is a plain string.
MEDIC_LLM_PROVIDER=gemini
MEDIC_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Seconds between model calls; the free tier allows 10 a minute.
MEDIC_LLM_MIN_INTERVAL_S=6.5
# ANTHROPIC_API_KEY=

# Target pipeline. Defaults resolve to ../marketing-attribution.
# PIPELINE_REPO=
# PIPELINE_DUCKDB=
# Where sandboxes (a 40 MB warehouse copy plus a worktree each) are created. Defaults to ./sandbox.
# MEDIC_SANDBOX_ROOT=

# Fine-grained PAT scoped to the pipeline repo only, contents + pull requests.
# Used only by `medic resume --push`.
GITHUB_TOKEN=
GITHUB_REPO=kingjaiteh/marketing-attribution-platform
# GITHUB_BASE_BRANCH=main

# Langfuse Cloud (free tier). EU: https://cloud.langfuse.com, US: https://us.cloud.langfuse.com
# Leave the keys blank to disable tracing; the callback becomes a no-op.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Pull requests: "dry-run" writes sandbox/incidents/<key>.pr.md, "push" commits the
# sandbox branch, pushes it, and opens a real PR. `medic resume --push` overrides.
MEDIC_PR_MODE=dry-run
# LangGraph checkpoints (SQLite). A run paused for review resumes from here.
# MEDIC_CHECKPOINT_DB=./checkpoints.sqlite

# Phase 4 only. Dagster webserver GraphQL endpoint (start_dagster.ps1 in the pipeline repo)
DAGSTER_GRAPHQL_URL=http://localhost:3000/graphql
